# Copy to .env and set your own Browserless token. Never commit .env.
BROWSERLESS_API_TOKEN=
BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io/chromium
# The free Browserless plan currently allows up to 120000 ms per session.
BROWSERLESS_SESSION_TIMEOUT_MS=120000
BROWSERLESS_LIVE_TIMEOUT_MS=120000
# Only needed if your Browserless Live URL uses a different HTTPS origin.
# BROWSERLESS_LIVE_ORIGIN=https://production-sfo.browserless.io
