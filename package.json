{
  "name": "qoder-agent-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test:aigc": "tsx scripts/aigc-integration-test.ts",
    "test:flow": "tsx scripts/agent-flow-test.ts",
    "test:models": "tsx scripts/model-selection-test.ts",
    "test:browser": "tsx scripts/browser-integration-test.ts",
    "test:mcp": "node scripts/mcp-integration-test.mjs",
    "test:skills": "tsx scripts/skill-integration-test.ts",
    "verify:apify": "tsx scripts/apify-verification.ts",
    "probe:memory": "tsx scripts/memory-probe.ts",
    "package:public": "node scripts/package-public.mjs",
    "quickstart": "node scripts/quickstart.mjs",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.83",
    "@qoder-ai/qoder-agent-sdk": "1.0.50",
    "chrome-devtools-mcp": "1.10.1",
    "express": "^5.1.0",
    "puppeteer-core": "25.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
